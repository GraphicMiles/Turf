# ---- Bachs (payments) ----
# Sandbox while building, live after KYC. Going live = swap these two.
BACHS_API_KEY=sk_sandbox_xxxxxxxxxxxx
BACHS_BASE_URL=https://sandbox-api.bachs.io
# Webhook signing secret (Developer Portal → Webhooks → your endpoint)
BACHS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Optional: Bachs product ids (Product → 1/5/10 spots).
# Leave unset to charge raw NGN amounts (100.00 / 500.00 / 1000.00) instead.
BACHS_PRODUCT_1=
BACHS_PRODUCT_5=
BACHS_PRODUCT_10=

# ---- Supabase (claims persistence) ----
# Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# Launch timestamp for the "Xh since launch" counter (ISO 8601)
TURF_LAUNCH_ISO=2026-08-26T00:00:00Z
