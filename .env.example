# ================= TURF F. — environment =================
# Copy to .env for local dev (never commit .env). On Vercel: Project →
# Settings → Environment Variables. Server-only secrets — the browser never
# sees these.

# ---- Supabase (REQUIRED — spots, ledger, media, profiles) ----
# Dashboard → Settings → API:
#   URL                     → SUPABASE_URL
#   service_role secret     → SUPABASE_SERVICE_ROLE_KEY  (NEVER the anon key)
# ⚠️ After setting these, run supabase/schema.sql in the SQL Editor once
#    (claims, ladder_entries, ladder_ledger, spot_posts, RPCs, RLS).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Bachs payments (REQUIRED for claims/overtakes) ----
# Developer Portal → API keys. Sandbox first; live after KYC = swap both.
BACHS_API_KEY=sk_sandbox_xxxxxxxxxxxx
BACHS_BASE_URL=https://sandbox-api.bachs.io
# Developer Portal → Webhooks → your endpoint. Set the endpoint URL to:
#   https://YOUR-DOMAIN/api/webhooks/bachs
BACHS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ---- App behaviour (OPTIONAL — sensible defaults if unset) ----
# Comma-separated origins allowed to redirect back to after payment and to
# POST mutations. Set this in production: https://yourdomain.com
# (local dev without it falls back to the request host — fine on localhost)
ALLOWED_ORIGINS=http://localhost:3000

# Ladder entry minimum in NGN (default 100). Overtake is always 2× the
# holder's payment regardless of this value.
LADDER_BASE_PRICE=100

# Legacy map counter start (optional, map.html only)
TURF_LAUNCH_ISO=2026-08-26T00:00:00Z

# Local dev server port (npm start) — production on Vercel ignores this
PORT=3000
